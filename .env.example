# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (dashboard do projeto -> Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — NUNCA expor ao client, usada só em server-side (ex.: criar
# usuários da equipe via Admin API). Dashboard -> Project Settings -> API ->
# secret key.
SUPABASE_SECRET_KEY=

# Usada para montar o link de "definir senha"/confirmação enviado a novos
# usuários (lib/site-url.ts). Se vazio, o app deduz a partir do header Host
# da requisição — cômodo em localhost/preview, mas em produção o Host pode
# não ser confiável dependendo do proxy na frente. OBRIGATÓRIO setar em
# produção (ex.: https://app.revenda360.com), pra esse link nunca apontar
# pra um domínio que não seja o app de verdade.
NEXT_PUBLIC_SITE_URL=
