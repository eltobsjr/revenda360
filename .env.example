# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (dashboard do projeto -> Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — NUNCA expor ao client, usada só em server-side (ex.: criar
# usuários da equipe via Admin API). Dashboard -> Project Settings -> API ->
# secret key.
SUPABASE_SECRET_KEY=

# Opcional — usada para montar o link de confirmação de e-mail no cadastro.
# Se vazio, o app deduz a partir do host da requisição (funciona em localhost).
NEXT_PUBLIC_SITE_URL=
